{
  "rules": {
    "users": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('roles').child(auth.uid).child('parent').val() == true)",
        ".write": "auth != null && auth.uid == $uid"
      }
    },
    "roles": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    },
    "progress": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('roles').child(auth.uid).child('parent').val() == true)",
        ".write": "auth != null && (auth.uid == $uid || root.child('roles').child(auth.uid).child('parent').val() == true)"
      }
    },
    "curriculum": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('roles').child(auth.uid).child('parent').val() == true"
    }
  }
}
