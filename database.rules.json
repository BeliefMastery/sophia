{
  "rules": {
    "roles": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    },
    "profiles": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('roles').child(auth.uid).child('parent').val() == true)",
        "name": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "placement": {
          ".write": "auth != null && root.child('roles').child(auth.uid).child('parent').val() == true"
        }
      }
    },
    "strands": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('roles').child(auth.uid).child('parent').val() == true",
      ".indexOn": ["domain", "order"]
    },
    "items": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('roles').child(auth.uid).child('parent').val() == true",
      ".indexOn": ["strandId", "order"]
    },
    "guides": {
      ".read": "auth != null && root.child('roles').child(auth.uid).child('parent').val() == true",
      ".write": "auth != null && root.child('roles').child(auth.uid).child('parent').val() == true"
    },
    "sources": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('roles').child(auth.uid).child('parent').val() == true"
    },
    "attempts": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('roles').child(auth.uid).child('parent').val() == true)",
        ".write": "auth != null && auth.uid == $uid",
        ".indexOn": ["strandId", "itemId", "submittedAt"]
      }
    },
    "reviews": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('roles').child(auth.uid).child('parent').val() == true)",
        ".write": "auth != null && root.child('roles').child(auth.uid).child('parent').val() == true",
        ".indexOn": ["itemId"]
      }
    },
    "mastery": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('roles').child(auth.uid).child('parent').val() == true)",
        ".write": "auth != null && root.child('roles').child(auth.uid).child('parent').val() == true"
      }
    }
  }
}
