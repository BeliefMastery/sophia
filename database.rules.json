{
  "rules": {
    "roles": {
      "$uid": {
        ".read": "auth != null && auth.uid == $uid",
        ".write": false
      }
    },
    "profiles": {
      ".read": "auth != null && root.child('roles').child(auth.uid).child('parent').val() == true",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('roles').child(auth.uid).child('parent').val() == true)",
        "name": {
          ".write": "auth != null && auth.uid == $uid"
        },
        "placement": {
          ".write": "auth != null && root.child('roles').child(auth.uid).child('parent').val() == true"
        }
      }
    },
    "strands": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('roles').child(auth.uid).child('parent').val() == true",
      ".indexOn": ["domain", "order"]
    },
    "items": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('roles').child(auth.uid).child('parent').val() == true",
      ".indexOn": ["strandId", "order"]
    },
    "guides": {
      ".read": "auth != null && root.child('roles').child(auth.uid).child('parent').val() == true",
      ".write": "auth != null && root.child('roles').child(auth.uid).child('parent').val() == true",
      "$itemId": {
        ".read": "auth != null && root.child('misses').child(auth.uid).child($itemId).child('matched').val() == false"
      }
    },
    "repairs": {
      ".read": "auth != null && root.child('roles').child(auth.uid).child('parent').val() == true",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('roles').child(auth.uid).child('parent').val() == true)",
        "$itemId": {
          ".write": "auth != null && auth.uid == $uid && !data.exists()",
          ".validate": "newData.hasChildren(['answer','submittedAt']) && newData.child('answer').isString() && newData.child('answer').val().length > 0 && newData.child('answer').val().length <= 2000 && newData.child('submittedAt').isNumber() && root.child('misses').child($uid).child($itemId).child('matched').val() == false"
        }
      }
    },
    "misses": {
      "$uid": {
        "$itemId": {
          ".write": "auth != null && auth.uid == $uid && !data.exists()",
          ".validate": "newData.hasChildren(['selected','matched','submittedAt']) && newData.child('selected').isString() && root.child('items').child($itemId).child('choices').child(newData.child('selected').val()).exists() && root.child('guides').child($itemId).child('answer').isString() && newData.child('matched').val() == false && newData.child('matched').val() == (newData.child('selected').val() == root.child('guides').child($itemId).child('answer').val()) && newData.child('submittedAt').isNumber()"
        }
      }
    },
    "sources": {
      ".read": "auth != null",
      ".write": "auth != null && root.child('roles').child(auth.uid).child('parent').val() == true"
    },
    "attempts": {
      ".read": "auth != null && root.child('roles').child(auth.uid).child('parent').val() == true",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('roles').child(auth.uid).child('parent').val() == true)",
        ".indexOn": ["strandId", "itemId", "submittedAt"],
        "$attemptId": {
          ".write": "auth != null && auth.uid == $uid && !data.exists()",
          ".validate": "newData.hasChildren(['itemId','strandId','ideaId','answerKind','submittedAt']) && root.child('items').child(newData.child('itemId').val()).exists() && newData.child('strandId').val() == root.child('items').child(newData.child('itemId').val()).child('strandId').val() && newData.child('ideaId').val() == root.child('items').child(newData.child('itemId').val()).child('ideaId').val() && newData.child('answerKind').val() == root.child('items').child(newData.child('itemId').val()).child('answerKind').val() && newData.child('submittedAt').isNumber() && ((newData.child('answerKind').val() != 'choice' && newData.child('answer').isString()) || (newData.child('answerKind').val() == 'choice' && newData.child('selected').isString() && root.child('items').child(newData.child('itemId').val()).child('choices').child(newData.child('selected').val()).exists() && root.child('guides').child(newData.child('itemId').val()).child('answer').isString() && newData.child('matched').isBoolean() && newData.child('matched').val() == (newData.child('selected').val() == root.child('guides').child(newData.child('itemId').val()).child('answer').val())))"
        }
      }
    },
    "reviews": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('roles').child(auth.uid).child('parent').val() == true)",
        ".write": "auth != null && root.child('roles').child(auth.uid).child('parent').val() == true",
        ".indexOn": ["itemId"]
      }
    },
    "mastery": {
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('roles').child(auth.uid).child('parent').val() == true)",
        ".write": "auth != null && root.child('roles').child(auth.uid).child('parent').val() == true"
      }
    },
    "catalog": {
      "interests": {
        ".read": "auth != null",
        ".write": "auth != null && root.child('roles').child(auth.uid).child('parent').val() == true"
      }
    },
    "interests": {
      ".read": "auth != null && root.child('roles').child(auth.uid).child('parent').val() == true",
      "$uid": {
        ".read": "auth != null && (auth.uid == $uid || root.child('roles').child(auth.uid).child('parent').val() == true)",
        ".write": "auth != null && auth.uid == $uid",
        ".validate": "newData.hasChild('updatedAt') && newData.child('updatedAt').isNumber()",
        "updatedAt": {
          ".validate": "newData.isNumber()"
        },
        "$optionId": {
          ".validate": "newData.isBoolean() && newData.val() == true && root.child('catalog').child('interests').child($optionId).exists()"
        }
      }
    }
  }
}
